# Terraform state — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variables with real values
*.tfvars

# Terraform directories
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# SSH keys — never commit
*.pem
*.key
id_rsa
id_rsa.pub

# OS files
.DS_Store
Thumbs.db
